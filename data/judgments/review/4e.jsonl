onents": [], "party_direction": null, "prejudice": null, "prevailing_party_text": null, "principal_amount": null, "reimbursement_amount": null, "restoration_amount": null, "review_reasons": [], "rule_id": "sfsc.strict_judgment_end_state.writ_denied", "rule_version": "2.9.1", "sanctions_amount": null, "satisfied_amount": null, "source_effect_count": 1, "source_effect_id": "0:writ_denied", "source_effect_index": 0, "source_evidence_hash": "8d6c027698e3afa7b27b8838ed25ddb66d2f948004ad4988da551e744c973c6f", "source_field": "description", "source_path": "$[\"docket_entries\"][13][\"description\"]", "source_row_hash": "f8524cb6a0b4d3bb7a3d1b5fc3473d559e728b3f", "source_text": "LAW AND MOTION 302, HEARING ON PETITION OF WRIT OF MANDATE. ARGUED AND THE COURT ADOPTED ITS TENTATIVE RULING AS FOLLOWS: WRIT IS GRANTED IN PART AND DENIED IN PART. THE ORDINANCE IS NOT SOLELY DIRECTED AT COMMERCIAL SPEECH AND THEREFORE THE ORDINANCE IS SUBJECT TO TRADITIONAL SCRUTINY. (SEE BABA VS. BOARD OF SUPERVISORS OF THE CITY AND COUNTY OF SAN FRANCISCO (2004) 124 CAL.APP.4TH, 504.) AS WRITTEN THE ORDINANCE IS UNCONSTITUTIONALLY VAGUE IN THAT THE PHRASE \"WITH ULTERIOR MOTIVE OR WITHOUT HONEST INTENT\" IS UNDEFINED AND FAILS TO GIVE ADEQUATE NOTICE. THAT PHRASE IS THEREFORE SEVERED PURSUANT TO 37.10B(D). THE PHRASE \"BAD FAITH\" ENJOYS SUCH COMMON USAGE TO OVERCOME ANY VAGUENESS CONCERNS. THE REMAINDER OF THE STATUTE IS NOT VAGUE. 37.10B(A) CLEARLY ENUMERATES CERTAIN BEHAVIOR THAT WOULD BE UNLAWFUL. THE ATTORNEY FEE PROVISION IN 37.10B(C)(6) IS UNCONSTITUTIONAL AND A VIOLATION OF THE EQUAL PROTECTION CLAUSE, IN THAT IT AUTHORIZES ATTORNEYS FEES TO A SINGLE CLASS OF LITIGANTS OR IN A SINGLE CLASS OF CASES. (SEE CITY OF ALTURAS VS. THE SUPERIOR COURT OF MODOC COUNTY (1940) 36 CAL.APP.2ND 457. THAT PROVISION IS SEVERED AND UNENFORCEABLE. PROPOSITION M'S REMEDIAL PROVISIONS FOR RENT REDUCTIONS DO NOT VIOLATE ARTICLE VI, SECTION 1 OF THE CALIFORNIA CONSTITUTION. THE PROVISIONS ARE NOT VAGUE, FACIALLY DEFECTIVE, OR CONSTITUTIONALLY INFIRM. RENT REDUCTIONS ARE WITHIN THE RENT BOARD'S POWERS. SUBSECTION 37.10B(C) DOES NOT PROVIDE THAT THE RENT BOARD WILL, OR HAS THE POWER TO, AWARD EMOTIONAL OR PUNITIVE DAMAGES. JUDGE: CHARLOTTE WALTER WOOLARD, REPORTER: KENT GUBBINE, CSR #5797", "status": "operative", "total_amount": null, "voluntariness": null}, {"case_closure_basis": null, "case_closure_effect": "unknown", "case_model": "writ_or_mandate", "case_number": "CPF08509083", "case_prefix": "CPF", "confidence": 1.0, "costs_amount": null, "current_effect": null, "currentness": "reference", "damages_amount": null, "disposition_domain": "nonoperative_reference", "disposition_domains": ["nonoperative_reference"], "disposition_scope": "unknown", "disposition_unit_key": "writ_or_mandate:nonoperative_reference:unknown:36b0e446e211b58eac3c0d29e14ed4f3de0d9274", "effect_scope": null, "entry_date": "2011-08-11 14:03:56", "entry_date_source_field": "date_filed", "entry_doc_id": null, "entry_doc_id_source_field": null, "entry_fee": null, "entry_fee_source_field": null, "entry_hash": "36b0e446e211b58eac3c0d29e14ed4f3de0d9274", "entry_seq": 18, "entry_seq_source_field": null, "event_kind": "judgment_reference", "extraction_period": "legacy_2000_2013", "fees_amount": null, "filing_year": "2008", "finality": "unknown", "interest_amount": null, "is_final_disposition": false, "is_modifiable": false, "is_modification": false, "liable_party_text": null, "money_mentions": [], "outcome_components": [], "party_direction": null, "prejudice": null, "prevailing_party_text": null, "principal_amount": null, "reimbursement_amount": null, "restoration_amount": null, "review_reasons": ["audited_stipulation_seeking_judgment"], "rule_id": "sfsc.strict_judgment_end_state.audited_stipulation_seeking_judgment", "rule_version": "2.9.1", "sanctions_amount": null, "satisfied_amount": null, "source_effect_count": 1, "source_effect_id": "0:audited_stipulation_seeking_judgment", "source_effect_index": 0, "s